# Database
APP_ENV=local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ion_gift_card
DB_SCHEMA=public
DB_POOL_MIN=0
DB_POOL_MAX=2

# Telegram Bot
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Required when TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
WEB_APP_URL=https://storage.yandexcloud.net/ion-gift-card-qr-mini-app-example/qr.html

# API
PORT=3000
API_HOST=0.0.0.0
